{
  "name": "anticlus",
  "version": "0.1.0",
  "description": "An authorization gateway for voice agents: nothing said on a call can open a protected action.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "anticlus": "dist/cli.js",
    "anticlus-mcp-proxy": "dist/mcp-proxy-cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "start": "tsx src/cli.ts",
    "example": "tsx examples/supplier-bank-change/run.ts",
    "bench": "tsx benchmark/run-baseline.ts",
    "example:mcp": "tsx examples/mcp-proxy/run.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.14.0",
    "@modelcontextprotocol/sdk": "1.32.0",
    "better-sqlite3": "^12.2.0",
    "hono": "^4.9.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0",
    "vitest": "^3.2.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild"
    ]
  }
}
